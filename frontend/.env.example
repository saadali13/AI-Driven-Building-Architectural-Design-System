# =============================================================================
# Frontend environment variables — EXAMPLE TEMPLATE
# =============================================================================
# Copy this file to frontend/.env  (never commit the real .env)
#   cp frontend/.env.example frontend/.env
# Then fill in your actual values.
# =============================================================================

# Supabase project URL (from Supabase Dashboard → Settings → API)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase anonymous (public) key — safe for frontend use
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Python backend API base URL
VITE_API_BASE_URL=http://127.0.0.1:8000
