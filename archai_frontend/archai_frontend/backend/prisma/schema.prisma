// ArchAI — AI-Driven Building Architecture Design System
// PostgreSQL schema (Dr. Aamer Nadeem, CUST)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum UserRole {
  SYSTEM_ADMIN
  ARCHITECT
  HOMEOWNER
  PROJECT_MANAGER
  VIEWER
}

enum ProjectStatus {
  DRAFT
  IN_PROGRESS
  REVIEW
  COMPLETED
  ARCHIVED
}

enum ProjectMemberRole {
  OWNER
  MANAGER
  EDITOR
  VIEWER
}

enum ShareLinkPermission {
  VIEW
  COMMENT
  EDIT
}

enum DesignStatus {
  DRAFT
  GENERATING
  READY
  APPROVED
  REJECTED
}

enum CostTier {
  ECONOMY
  STANDARD
  LUXURY
}

enum MaterialCategory {
  CEMENT
  STEEL
  BRICKS
  AGGREGATE
  FINISHING
  GLASS
  WOOD
  STONE
  LABOR
  OTHER
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  EXPORT
  GENERATE
  APPROVE
  REJECT
  RESTORE
  SHARE
  REVOKE
  SEARCH
}

// ---------------------------------------------------------------------------
// Core entities
// ---------------------------------------------------------------------------

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  name         String
  role         UserRole @default(HOMEOWNER)
  isActive     Boolean  @default(true) @map("is_active")
  is2faEnabled Boolean  @default(false) @map("is_2fa_enabled")
  totpSecret   String?  @map("totp_secret")
  lastLoginAt  DateTime? @map("last_login_at")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  ownedProjects    Project[]        @relation("ProjectOwner")
  projectMembers   ProjectMember[]
  designs          Design[]         @relation("DesignAuthor")
  designSnapshots  DesignSnapshot[] @relation("SnapshotAuthor")
  costEstimates    CostEstimate[]   @relation("CostEstimateAuthor")
  auditLogs        AuditLog[]
  shareLinksCreated ProjectShareLink[] @relation("ShareLinkCreator")

  @@index([role])
  @@map("users")
}

model Project {
  id              String        @id @default(cuid())
  name            String
  description     String?
  status          ProjectStatus @default(DRAFT)
  plotSizeMarla   Decimal?      @map("plot_size_marla") @db.Decimal(6, 2)
  coveredAreaSqFt Int?          @map("covered_area_sq_ft")
  location        String?
  ownerId         String        @map("owner_id")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  owner         User               @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  members       ProjectMember[]
  designs       Design[]
  costEstimates CostEstimate[]
  shareLinks    ProjectShareLink[]

  @@index([ownerId])
  @@index([status])
  @@map("projects")
}

model ProjectMember {
  id        String            @id @default(cuid())
  projectId String            @map("project_id")
  userId    String            @map("user_id")
  role      ProjectMemberRole @default(VIEWER)
  joinedAt  DateTime          @default(now()) @map("joined_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([userId])
  @@map("project_members")
}

model ProjectShareLink {
  id         String              @id @default(cuid())
  projectId  String              @map("project_id")
  token      String              @unique
  permission ShareLinkPermission @default(VIEW)
  expiresAt  DateTime?           @map("expires_at")
  isActive   Boolean             @default(true) @map("is_active")
  createdById String             @map("created_by_id")
  createdAt  DateTime            @default(now()) @map("created_at")
  revokedAt  DateTime?           @map("revoked_at")

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy User    @relation("ShareLinkCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([projectId])
  @@index([token])
  @@map("project_share_links")
}

model Design {
  id              String       @id @default(cuid())
  projectId       String       @map("project_id")
  title           String
  promptText      String?      @map("prompt_text") @db.Text
  floorPlanJson   Json?        @map("floor_plan_json")
  facadeImageUrl  String?      @map("facade_image_url")
  similarityScore Float?       @map("similarity_score")
  bedCount        Int?         @map("bed_count")
  bathCount       Int?         @map("bath_count")
  version         Int          @default(1)
  status          DesignStatus @default(DRAFT)
  createdById     String       @map("created_by_id")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  project       Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy     User             @relation("DesignAuthor", fields: [createdById], references: [id], onDelete: Restrict)
  snapshots     DesignSnapshot[]
  costEstimates CostEstimate[]
  materials     DesignMaterial[]

  @@index([projectId])
  @@index([createdById])
  @@index([status])
  @@map("designs")
}

model DesignSnapshot {
  id            String   @id @default(cuid())
  designId      String   @map("design_id")
  version       Int
  label         String?
  promptText    String?  @map("prompt_text") @db.Text
  floorPlanJson Json     @map("floor_plan_json")
  createdById   String   @map("created_by_id")
  createdAt     DateTime @default(now()) @map("created_at")

  design    Design @relation(fields: [designId], references: [id], onDelete: Cascade)
  createdBy User   @relation("SnapshotAuthor", fields: [createdById], references: [id], onDelete: Restrict)

  @@unique([designId, version])
  @@index([designId])
  @@map("design_snapshots")
}

model ArchitextVectorRecord {
  id              String   @id @default(cuid())
  externalId      String   @unique @map("external_id")
  promptText      String   @map("prompt_text") @db.Text
  floorPlanJson   Json     @map("floor_plan_json")
  bedCount        Int?     @map("bed_count")
  bathCount       Int?     @map("bath_count")
  plotMarla       Decimal? @map("plot_marla") @db.Decimal(6, 2)
  chromaId        String?  @unique @map("chroma_id")
  embeddingDim    Int      @default(384) @map("embedding_dim")
  indexedAt       DateTime @default(now()) @map("indexed_at")

  @@index([plotMarla])
  @@map("architext_vector_records")
}

model Material {
  id           String           @id @default(cuid())
  name         String
  category     MaterialCategory
  unit         String
  unitPricePkr Decimal          @map("unit_price_pkr") @db.Decimal(14, 2)
  supplier     String?
  imageUrl     String?          @map("image_url")
  description  String?          @db.Text
  isActive     Boolean          @default(true) @map("is_active")
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")

  designs DesignMaterial[]

  @@index([category])
  @@index([isActive])
  @@map("materials")
}

model DesignMaterial {
  designId   String  @map("design_id")
  materialId String  @map("material_id")
  quantity   Decimal @db.Decimal(12, 3)
  notes      String?

  design   Design   @relation(fields: [designId], references: [id], onDelete: Cascade)
  material Material @relation(fields: [materialId], references: [id], onDelete: Restrict)

  @@id([designId, materialId])
  @@map("design_materials")
}

model CostEstimate {
  id              String   @id @default(cuid())
  projectId       String   @map("project_id")
  designId        String?  @map("design_id")
  tier            CostTier @default(STANDARD)
  coveredAreaSqFt Int      @map("covered_area_sq_ft")
  cementCostPkr   Decimal  @map("cement_cost_pkr") @db.Decimal(14, 2)
  steelCostPkr    Decimal  @map("steel_cost_pkr") @db.Decimal(14, 2)
  bricksCostPkr   Decimal  @map("bricks_cost_pkr") @db.Decimal(14, 2)
  laborCostPkr    Decimal  @map("labor_cost_pkr") @db.Decimal(14, 2)
  otherCostPkr    Decimal  @default(0) @map("other_cost_pkr") @db.Decimal(14, 2)
  grandTotalPkr   Decimal  @map("grand_total_pkr") @db.Decimal(14, 2)
  currency        String   @default("PKR")
  multiplier      Decimal  @default(1.0) @db.Decimal(4, 2)
  notes           String?  @db.Text
  createdById     String   @map("created_by_id")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  design    Design? @relation(fields: [designId], references: [id], onDelete: SetNull)
  createdBy User    @relation("CostEstimateAuthor", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([projectId])
  @@index([designId])
  @@index([tier])
  @@map("cost_estimates")
}

model AuditLog {
  id         String      @id @default(cuid())
  userId     String?     @map("user_id")
  action     AuditAction
  entityType String      @map("entity_type")
  entityId   String?     @map("entity_id")
  metadata   Json?
  ipAddress  String?     @map("ip_address")
  userAgent  String?     @map("user_agent") @db.Text
  createdAt  DateTime    @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([entityType, entityId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}
