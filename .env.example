# =============================================================================
# AI-Driven Building Architectural Design System
# Environment Variables — EXAMPLE TEMPLATE
# =============================================================================
# Copy this file to .env (never commit the real .env)
#   cp .env.example .env
# Then fill in your actual values.
# =============================================================================

# ---------------------------------------------------------------------------
# GOOGLE GEMINI AI  (Required for NLP parsing and architectural auditing)
# ---------------------------------------------------------------------------
# Obtain from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ---------------------------------------------------------------------------
# SUPABASE  (Required for frontend authentication and database)
# ---------------------------------------------------------------------------
# Obtain from: Supabase Dashboard → Project Settings → API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# ---------------------------------------------------------------------------
# BACKEND API  (Frontend configuration)
# ---------------------------------------------------------------------------
# URL where api_server.py is running
VITE_API_BASE_URL=http://127.0.0.1:8000

# ---------------------------------------------------------------------------
# OPTIONAL — SERVER CONFIGURATION
# ---------------------------------------------------------------------------
# Port for the Python API server (default: 8000)
API_PORT=8000

# Host binding (default: 127.0.0.1 for local development)
API_HOST=127.0.0.1

# ---------------------------------------------------------------------------
# OPTIONAL — BLENDER PATH  (Required only for 3D .blend generation)
# ---------------------------------------------------------------------------
# Path to your Blender 5.1 executable
# Windows example: C:\Program Files\Blender Foundation\Blender 5.1\blender.exe
# Linux/macOS example: /usr/bin/blender
BLENDER_EXECUTABLE_PATH=

# ---------------------------------------------------------------------------
# NOTES
# ---------------------------------------------------------------------------
# 1. Never commit your real .env to version control.
# 2. The GEMINI_API_KEY is read by config/gemini_config.py via os.environ.get()
# 3. Supabase ANON key is safe for frontend use (it is a public, scoped key)
#    but the SERVICE_ROLE key must NEVER be placed in frontend code.
# 4. For production deployments, set these variables in your hosting platform
#    (Vercel, Railway, Render, AWS, etc.) — never hard-code them.
